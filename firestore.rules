rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isIdentityOwner(identityData) {
      return isSignedIn() && identityData.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isOwner(userId);
    }

    match /identities/{identityId} {
      allow get: if resource.data.isPublic == true || isIdentityOwner(resource.data);
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.kinoraId is string
        && request.resource.data.name is string
        && request.resource.data.genericName is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.kinoraId.matches('^KR-[A-Z0-9]{4}-[A-Z0-9]{7}$');
      allow update: if isIdentityOwner(resource.data)
        && request.resource.data.kinoraId == resource.data.kinoraId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isIdentityOwner(resource.data);
    }

    match /contactRequests/{requestId} {
      allow create: if request.resource.data.identityId is string
        && request.resource.data.ownerId == get(/databases/$(database)/documents/identities/$(request.resource.data.identityId)).data.createdBy
        && get(/databases/$(database)/documents/identities/$(request.resource.data.identityId)).data.isPublic == true
        && request.resource.data.senderName is string
        && request.resource.data.senderEmail is string
        && request.resource.data.message is string;
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/identities/$(resource.data.identityId)).data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/identities/$(resource.data.identityId)).data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /privateIdentityData/{identityId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}
